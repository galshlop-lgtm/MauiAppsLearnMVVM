<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MVVMBBasic.Views.WelcomePage"
             xmlns:vm="clr-namespace:MVVMBBasic.ViewModels"
             x:DataType="vm:WelcomeViewModel"
             Title="Welcome">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="20"
                             VerticalOptions="Center">

            <Label Text="Welcome"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="Choose a calculator"
                   FontSize="18"
                   HorizontalOptions="Center" />

            <Button Text="Age calculator"
                    FontSize="18"
                    HeightRequest="55"
                   HorizontalOptions="Fill"
                   Command="{Binding OpenAgeCalculatorCommand}" />

            <Button Text="Change calculator"
                    FontSize="18"
                    HeightRequest="55"
                   HorizontalOptions="Fill"
                   Command="{Binding OpenChangeCalculatorCommand}" />

            <Button Text="Math calculator"
                    FontSize="18"
                    HeightRequest="55"
                   HorizontalOptions="Fill"
                   Command="{Binding OpenMathCalculatorCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>