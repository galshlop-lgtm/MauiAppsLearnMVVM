<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MVVMBBasic.Views.CalcAgePage"
             xmlns:vm="clr-namespace:MVVMBBasic.ViewModels"
             x:DataType="vm:CalcAgeViewModel"
             Title="{Binding Title}">

    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">

        <Entry Text="{Binding YearOfBirth}" 
               Placeholder="Enter your birth year (for example: 1995)" 
               Keyboard="Numeric" />

        <Button Text="Calculate age" 
                Command="{Binding CalculateAgeCommand}" />

        <Label Text="{Binding Result}" 
               FontSize="20" 
               HorizontalOptions="Center" />

    </VerticalStackLayout>
</ContentPage>
